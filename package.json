{
	"name": "slabbot",
	"version": "0.5.0-next",
	"description": "another discord bot with features nobody asked for",
	"private": "true",
	"type": "module",
	"scripts": {
		"lint": "eslint src",
		"knip": "knip",
		"setup": "node src/setup.js",
		"build": "tsc",
		"clean": "rimraf dist tsconfig.tsbuildinfo",
		"start": "node dist/index.js",
		"dev": "NODE_ENV=dev nodemon dist/index.js",
		"mongo": "mongod --dbpath ./db",
		"deploy": "node dist/manual/deploy-commands.js",
		"speak": "node dist/manual/speak.js"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/12beesinatrenchcoat/slabbot.git"
	},
	"author": "Andy Chan (12beesinatrenchcoat) <andy@12beesinatrenchco.at>",
	"license": "MIT",
	"engines": {
		"node": ">=22",
		"pnpm": ">=9"
	},
	"dependencies": {
		"@discordjs/rest": "^2.4.2",
		"@inquirer/prompts": "^7.2.1",
		"colord": "^2.9.3",
		"dayjs": "^1.11.13",
		"discord-api-types": "^0.37.115",
		"discord.js": "^14.17.2",
		"dotenv": "^16.4.7",
		"mongoose": "^8.9.3",
		"node-cache": "^5.1.2",
		"node-fetch": "^3.3.2",
		"pino": "^9.6.0",
		"reflect-metadata": "^0.2.2",
		"tsyringe": "^4.8.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.17.0",
		"@types/node": "^22.10.4",
		"eslint": "^9.17.0",
		"eslint-config-xo": "^0.46.0",
		"globals": "^15.14.0",
		"knip": "^5.41.1",
		"nodemon": "^3.1.9",
		"pino-pretty": "^13.0.0",
		"rimraf": "^6.0.1",
		"typescript": "^5.7.2",
		"typescript-eslint": "^8.19.0"
	},
	"packageManager": "pnpm@9.15.2+sha512.93e57b0126f0df74ce6bff29680394c0ba54ec47246b9cf321f0121d8d9bb03f750a705f24edc3c1180853afd7c2c3b94196d0a3d53d3e069d9e2793ef11f321"
}
